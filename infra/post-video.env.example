# API COMPATIBILITY MODE: safe defaults while the 500 MiB path is disabled.
# Never ship these to clients. Do not paste a worker activation config into API.
POST_VIDEO_UPLOADS_ENABLED=false
CLIP_HLS_ENABLED=true
# Retain the embedded worker until a compatible dedicated consumer is healthy.
CLIP_HLS_WORKER_ENABLED=true
CLIP_HLS_WORKER_CONCURRENCY=1
CLIP_HLS_JOB_ATTEMPTS=3
VIDEO_FFMPEG_THREADS=2
POST_VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_WORKER_HEALTH_PORT=5002
# 0 retains verified READY originals pending an approved retention decision.
# Expired/cancelled unpublished sources are still collected after session expiry.
POST_VIDEO_SOURCE_RETENTION_DAYS=0
# Only true after unsigned CDN/source denial has been verified.
POST_VIDEO_PRIVATE_DELIVERY_ENABLED=false
# The deployment script pins VIDEO_DEPLOYMENT_MODE=compatibility on API TASKS.
# Do not store that bootstrap control in the shared runtime secret.
# ACTIVATION ONLY, after approval: dedicated worker and API use
# CLIP_HLS_WORKER_ENABLED=false; remove API compatibility mode before enabling
# new sessions/private delivery. Drain and health-check consumers first.
POST_VIDEO_CLOUDFRONT_URL=https://REPLACE_WITH_SIGNED_MEDIA_DOMAIN
POST_VIDEO_API_ORIGIN=https://REPLACE_WITH_API_DOMAIN
POST_VIDEO_CLOUDFRONT_KEY_PAIR_ID=REPLACE_WITH_PUBLIC_KEY_ID
# Store actual values in Secrets Manager, not in this template or Git.
POST_VIDEO_CLOUDFRONT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY
POST_VIDEO_PLAYBACK_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# STAGING TASK BOOTSTRAP (explicit task variables, not runtime-secret contents):
# NODE_ENV=production
# DEPLOYMENT_ENVIRONMENT=staging
# BACKEND_SECRET_ID=arc/staging/backend
# STAGING_MONGODB_HOST=<approved isolated staging endpoint>
# STAGING_MONGODB_DATABASE=<approved staging database>
# STAGING_REDIS_HOST=<approved isolated staging endpoint>
# STAGING_S3_BUCKET=<approved isolated staging bucket>
# All four identities must include a separated stage/staging marker and match
# the hydrated connection settings. Use ECS task-role credentials, not static
# AWS keys. Apply reviewed stage-only IAM/network guardrails separately.
