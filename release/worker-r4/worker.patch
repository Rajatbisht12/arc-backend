+    check(consumerClosed&&intake.snapshot().closing&&intake.snapshot().activeJobs===0&&witness.snapshot().activeFfmpeg===0,'DRAIN_CHANGED');
+    check(!releaseStarted,'RELEASE_ALREADY_ATTEMPTED');releaseStarted=true;
