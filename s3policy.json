{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::arc-gaming-media-906446637180/*"
    },
    {
      "Sid": "ClipHlsPrefixListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::arc-gaming-media-906446637180",
      "Condition": {
        "StringLike": {
          "s3:prefix": "gaming-social/clips/*"
        }
      }
    }
  ]
}
